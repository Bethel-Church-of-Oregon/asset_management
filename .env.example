# ── Neon Postgres ───────────────────────────────────────────────────────────
# Neon 콘솔 > Project > Connection string > "Pooled connection" 값을 붙여넣으세요.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── 세션 서명 키 ─────────────────────────────────────────────────────────────
# 아래 명령으로 생성: openssl rand -base64 32
AUTH_SECRET="여기에-32바이트-이상의-랜덤-문자열"

# ── 최초 관리자 계정 (npm run db:seed 에서만 사용) ──────────────────────────
# 로그인은 이메일이 아니라 아이디로 합니다.
# 아이디 규칙: 영문 소문자로 시작하는 3~30자 (영문·숫자·. _ - 사용 가능)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="관리자"
SEED_ADMIN_PASSWORD="변경하세요"
# 선택 — 연락처용입니다. 로그인에는 쓰이지 않습니다.
SEED_ADMIN_EMAIL="admin@church.org"
